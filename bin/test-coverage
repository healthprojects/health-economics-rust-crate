#!/usr/bin/env bash
# Measure coverage and enforce complete line, function, and region coverage.
# Requires cargo-llvm-cov: cargo install cargo-llvm-cov --locked
# Usage: bin/test-coverage   # HTML report: target/llvm-cov/html/index.html
set -euo pipefail
cd "$(dirname "${BASH_SOURCE[0]}")/.."

# kache's test-runner protects the ordinary target directory, but llvm-cov
# intentionally uses its own instrumented target directory.
if [[ "${CARGO_TARGET_AARCH64_APPLE_DARWIN_RUNNER:-}" == "kache test-runner" ]]; then
  unset CARGO_TARGET_AARCH64_APPLE_DARWIN_RUNNER
fi

cargo llvm-cov --all-targets --all-features --no-report

# Cargo builds examples as zero-test harnesses for `--all-targets`; execute the
# shipped programs as well so their real integration paths remain healthy.
for example in \
  business_case \
  engineering_economics \
  qaly_to_decision \
  screening_and_diagnostics \
  uncertainty_and_information \
  unit_economics
do
  cargo llvm-cov --no-clean --summary-only run --example "${example}"
done
cargo llvm-cov --no-clean --summary-only run

cargo llvm-cov report \
  --html \
  --output-dir target/llvm-cov \
  --fail-under-lines 100 \
  --fail-under-functions 100 \
  --fail-under-regions 100
